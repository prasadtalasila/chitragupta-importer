# Settings for scripts/rc-daemon.sh, sourced at startup. Copy this file to
# scripts/rc-daemon.env (gitignored) to change them locally; without a copy
# the script reads this file. Each line keeps a value already in the
# environment, so a one-off override still works:
#   RC_NAME=other scripts/rc-daemon.sh start
# SELF (the resolved path of rc-daemon.sh) is set before this file is read.

# Directory claude remote-control runs in; it must be a trusted workspace.
# Defaults to the root of this repository.
RC_DIR="${RC_DIR:-$(dirname "$(dirname "$SELF")")}"
# Remote Control session name, and the prefix for sessions spawned from it.
RC_NAME="${RC_NAME:-chitragupta-importer}"
RC_PREFIX="${RC_PREFIX:-chitragupta-importer}"
RC_PERMISSION_MODE="${RC_PERMISSION_MODE:-bypassPermissions}"
# How a session started from the app gets its directory: worktree (its own
# git worktree of RC_DIR), same-dir (all sessions share RC_DIR) or session.
# worktree falls back to same-dir, with a line in the log, when RC_DIR is
# not a git repository.
RC_SPAWN="${RC_SPAWN:-worktree}"
# Distinct per daemon, so two copies of the script can run side by side.
TMUX_SESSION="${TMUX_SESSION:-chitragupta-importer}"
RC_LOG="${RC_LOG:-$HOME/claude-daemon/chitragupta-importer.log}"
